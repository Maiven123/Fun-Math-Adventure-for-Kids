@import url('https://fonts.googleapis.com/css2?family=Fredoka+One&family=Nunito:wght@400;600;700;800&display=swap');

:root {
  --sky: #FFF9F0;
  --sun: #FFD93D;
  --coral: #FF6B6B;
  --mint: #6BCB77;
  --blue: #4D96FF;
  --purple: #C77DFF;
  --orange: #FF9A3C;
  --dark: #2D2D2D;
  --card: #FFFFFF;
  --radius: 28px;
  --shadow: 0 8px 32px rgba(0,0,0,0.12);
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: 'Nunito', sans-serif;
  background: var(--sky);
  min-height: 100vh;
  overflow-x: hidden;
  position: relative;
}

body::before {
  content: '';
  position: fixed;
  inset: 0;
  background:
    radial-gradient(circle at 10% 20%, #FFE08A44 0%, transparent 40%),
    radial-gradient(circle at 90% 80%, #C7F2A444 0%, transparent 40%),
    radial-gradient(circle at 50% 50%, #D4AAFF33 0%, transparent 60%);
  pointer-events: none;
  z-index: 0;
}

.stars {
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 0;
  overflow: hidden;
}

.star {
  position: absolute;
  font-size: 1.4rem;
  animation: floatStar linear infinite;
  opacity: 0.5;
}

@keyframes floatStar {
  0%   { transform: translateY(110vh) rotate(0deg); opacity: 0; }
  10%  { opacity: 0.5; }
  90%  { opacity: 0.5; }
  100% { transform: translateY(-10vh) rotate(360deg); opacity: 0; }
}

#app {
  position: relative;
  z-index: 1;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24px 16px;
}

.header {
  text-align: center;
  margin-bottom: 24px;
  animation: popIn 0.6s cubic-bezier(.34,1.56,.64,1) both;
}

.header h1 {
  font-family: 'Fredoka One', cursive;
  font-size: clamp(2rem, 6vw, 3rem);
  background: linear-gradient(135deg, var(--coral), var(--purple), var(--blue));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  letter-spacing: 1px;
  text-shadow: none;
}

.header .subtitle {
  font-size: 1rem;
  color: #888;
  margin-top: 4px;
  font-weight: 700;
}

.progress-wrap {
  width: 100%;
  max-width: 540px;
  margin-bottom: 18px;
  animation: slideDown 0.4s ease both;
  animation-delay: 0.1s;
}

.progress-label {
  font-size: 0.9rem;
  font-weight: 800;
  color: var(--blue);
  margin-bottom: 6px;
  display: flex;
  justify-content: space-between;
}

.progress-bar-bg {
  background: #E0E0E0;
  border-radius: 100px;
  height: 14px;
  overflow: hidden;
  box-shadow: inset 0 2px 4px rgba(0,0,0,0.08);
}

.progress-bar-fill {
  height: 100%;
  border-radius: 100px;
  background: linear-gradient(90deg, var(--mint), var(--blue));
  transition: width 0.5s cubic-bezier(.34,1.56,.64,1);
  position: relative;
}

.progress-bar-fill::after {
  content: '⭐';
  position: absolute;
  right: -8px;
  top: 50%;
  transform: translateY(-50%);
  font-size: 1rem;
  filter: drop-shadow(0 2px 4px rgba(0,0,0,0.2));
}

.score-badge {
  position: fixed;
  top: 18px;
  right: 18px;
  background: var(--sun);
  border-radius: 50px;
  padding: 8px 18px;
  font-family: 'Fredoka One', cursive;
  font-size: 1.1rem;
  color: var(--dark);
  box-shadow: 0 4px 16px rgba(0,0,0,0.15);
  z-index: 100;
  display: flex;
  align-items: center;
  gap: 6px;
  transition: transform 0.3s cubic-bezier(.34,1.56,.64,1);
}

.score-badge.pop {
  animation: scorePop 0.4s cubic-bezier(.34,1.56,.64,1);
}

@keyframes scorePop {
  0%   { transform: scale(1); }
  50%  { transform: scale(1.3); }
  100% { transform: scale(1); }
}

.card {
  background: var(--card);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: 36px 32px;
  width: 100%;
  max-width: 540px;
  animation: cardIn 0.5s cubic-bezier(.34,1.56,.64,1) both;
  position: relative;
  overflow: hidden;
  border: 3px solid transparent;
}

.card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 6px;
  background: linear-gradient(90deg, var(--coral), var(--sun), var(--mint), var(--blue), var(--purple));
  border-radius: var(--radius) var(--radius) 0 0;
}

@keyframes cardIn {
  0%   { opacity: 0; transform: translateY(40px) scale(0.95); }
  100% { opacity: 1; transform: translateY(0) scale(1); }
}

.question-num {
  font-size: 0.85rem;
  font-weight: 800;
  color: #AAA;
  text-transform: uppercase;
  letter-spacing: 2px;
  margin-bottom: 12px;
}

.question-text {
  font-family: 'Fredoka One', cursive;
  font-size: clamp(1.3rem, 4vw, 1.7rem);
  color: var(--dark);
  margin-bottom: 20px;
  line-height: 1.4;
}

.emoji-display {
  background: linear-gradient(135deg, #FFF5E0, #F0F8FF);
  border-radius: 20px;
  padding: 20px;
  margin-bottom: 24px;
  text-align: center;
  font-size: clamp(2rem, 6vw, 2.8rem);
  letter-spacing: 4px;
  line-height: 1.5;
  min-height: 80px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 6px;
  border: 2px dashed #E8E8E8;
}

.emoji-display .operator {
  font-family: 'Fredoka One', cursive;
  font-size: 1.6rem;
  color: var(--coral);
  margin: 0 8px;
}

.answers {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  justify-content: center;
}

.answer-btn {
  flex: 1 1 calc(50% - 12px);
  min-width: 110px;
  padding: 18px 12px;
  font-family: 'Fredoka One', cursive;
  font-size: 1.5rem;
  background: white;
  border: 3px solid #E8E8E8;
  border-radius: 20px;
  cursor: pointer;
  color: var(--dark);
  transition: all 0.2s cubic-bezier(.34,1.56,.64,1);
  position: relative;
  overflow: hidden;
  box-shadow: 0 4px 0 #E0E0E0;
}

.answer-btn:hover:not(:disabled) {
  transform: translateY(-4px) scale(1.04);
  border-color: var(--blue);
  box-shadow: 0 8px 0 #C8DCF8;
  background: #F0F6FF;
}

.answer-btn:active:not(:disabled) {
  transform: translateY(2px) scale(0.98);
  box-shadow: 0 2px 0 #E0E0E0;
}

.answer-btn.correct {
  background: linear-gradient(135deg, #D4FFDA, #A8F0B0);
  border-color: var(--mint);
  box-shadow: 0 4px 0 #7DD880;
  color: #1A7A25;
  animation: correctBounce 0.5s cubic-bezier(.34,1.56,.64,1);
}

.answer-btn.wrong {
  background: linear-gradient(135deg, #FFD4D4, #FFB0B0);
  border-color: var(--coral);
  box-shadow: 0 4px 0 #FF8888;
  color: #A01010;
  animation: wrongShake 0.4s ease;
}

.answer-btn:disabled {
  cursor: not-allowed;
}

@keyframes correctBounce {
  0%   { transform: scale(1); }
  30%  { transform: scale(1.15); }
  60%  { transform: scale(0.95); }
  100% { transform: scale(1); }
}

@keyframes wrongShake {
  0%,100% { transform: translateX(0); }
  20%     { transform: translateX(-8px); }
  40%     { transform: translateX(8px); }
  60%     { transform: translateX(-5px); }
  80%     { transform: translateX(5px); }
}

.feedback {
  text-align: center;
  margin-top: 18px;
  min-height: 56px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 6px;
}

.feedback-emoji {
  font-size: 2.4rem;
  display: block;
  animation: popIn 0.4s cubic-bezier(.34,1.56,.64,1);
}

.feedback-text {
  font-family: 'Fredoka One', cursive;
  font-size: 1.2rem;
  animation: slideUp 0.3s ease both;
}

.feedback-text.correct { color: var(--mint); }
.feedback-text.wrong   { color: var(--coral); }

@keyframes popIn {
  0%   { transform: scale(0) rotate(-20deg); opacity: 0; }
  70%  { transform: scale(1.2) rotate(5deg); }
  100% { transform: scale(1) rotate(0); opacity: 1; }
}

@keyframes slideUp {
  0%   { transform: translateY(10px); opacity: 0; }
  100% { transform: translateY(0); opacity: 1; }
}

@keyframes slideDown {
  0%   { transform: translateY(-10px); opacity: 0; }
  100% { transform: translateY(0); opacity: 1; }
}

.confetti-wrap {
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 999;
  overflow: hidden;
}

.confetti-piece {
  position: absolute;
  width: 10px;
  height: 10px;
  border-radius: 2px;
  animation: confettiFall 1.2s ease-out forwards;
}

@keyframes confettiFall {
  0%   { transform: translateY(-20px) rotate(0deg); opacity: 1; }
  100% { transform: translateY(100vh) rotate(720deg); opacity: 0; }
}

.next-btn {
  display: block;
  width: 100%;
  max-width: 540px;
  margin-top: 16px;
  padding: 18px;
  font-family: 'Fredoka One', cursive;
  font-size: 1.3rem;
  color: white;
  background: linear-gradient(135deg, var(--blue), var(--purple));
  border: none;
  border-radius: 20px;
  cursor: pointer;
  box-shadow: 0 6px 0 #3366CC;
  transition: all 0.2s cubic-bezier(.34,1.56,.64,1);
  animation: slideDown 0.4s ease both;
  animation-delay: 0.2s;
}

.next-btn:hover {
  transform: translateY(-3px);
  box-shadow: 0 9px 0 #3366CC;
}

.next-btn:active {
  transform: translateY(3px);
  box-shadow: 0 3px 0 #3366CC;
}

.next-btn:disabled {
  background: #C0C0C0;
  box-shadow: 0 6px 0 #A0A0A0;
  cursor: not-allowed;
  transform: none;
}

.results-card {
  background: white;
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: 48px 32px;
  width: 100%;
  max-width: 540px;
  text-align: center;
  animation: cardIn 0.5s cubic-bezier(.34,1.56,.64,1) both;
  position: relative;
  overflow: hidden;
}

.results-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 6px;
  background: linear-gradient(90deg, var(--coral), var(--sun), var(--mint), var(--blue), var(--purple));
}

.results-trophy {
  font-size: 5rem;
  display: block;
  margin-bottom: 12px;
  animation: popIn 0.6s cubic-bezier(.34,1.56,.64,1) both;
  animation-delay: 0.2s;
}

.results-title {
  font-family: 'Fredoka One', cursive;
  font-size: 2.2rem;
  background: linear-gradient(135deg, var(--coral), var(--purple));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 8px;
}

.results-message {
  font-size: 1.15rem;
  font-weight: 700;
  color: #666;
  margin-bottom: 28px;
}

.score-display {
  background: linear-gradient(135deg, #FFF5E0, #E8F4FF);
  border-radius: 20px;
  padding: 20px;
  margin-bottom: 28px;
  border: 2px dashed #E8E8E8;
}

.score-display .score-num {
  font-family: 'Fredoka One', cursive;
  font-size: 3.5rem;
  background: linear-gradient(135deg, var(--coral), var(--blue));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  line-height: 1;
}

.score-display .score-label {
  font-size: 0.9rem;
  color: #AAA;
  font-weight: 700;
  margin-top: 4px;
}

.stars-row {
  display: flex;
  justify-content: center;
  gap: 8px;
  margin-bottom: 24px;
}

.star-icon {
  font-size: 2rem;
  animation: popIn 0.4s cubic-bezier(.34,1.56,.64,1) both;
}

.restart-btn {
  display: inline-block;
  padding: 18px 48px;
  font-family: 'Fredoka One', cursive;
  font-size: 1.3rem;
  color: white;
  background: linear-gradient(135deg, var(--coral), var(--orange));
  border: none;
  border-radius: 20px;
  cursor: pointer;
  box-shadow: 0 6px 0 #CC4444;
  transition: all 0.2s cubic-bezier(.34,1.56,.64,1);
}

.restart-btn:hover {
  transform: translateY(-3px);
  box-shadow: 0 9px 0 #CC4444;
}

.restart-btn:active {
  transform: translateY(3px);
  box-shadow: 0 3px 0 #CC4444;
}

.start-card {
  background: white;
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: 48px 32px;
  width: 100%;
  max-width: 540px;
  text-align: center;
  animation: cardIn 0.6s cubic-bezier(.34,1.56,.64,1) both;
  position: relative;
  overflow: hidden;
}

.start-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 6px;
  background: linear-gradient(90deg, var(--coral), var(--sun), var(--mint), var(--blue), var(--purple));
}

.start-emojis {
  font-size: 3.5rem;
  margin-bottom: 16px;
  animation: floatBob 2s ease-in-out infinite;
}

@keyframes floatBob {
  0%,100% { transform: translateY(0); }
  50%     { transform: translateY(-10px); }
}

.start-title {
  font-family: 'Fredoka One', cursive;
  font-size: 2.4rem;
  background: linear-gradient(135deg, var(--coral), var(--purple), var(--blue));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 8px;
}

.start-desc {
  font-size: 1.05rem;
  color: #888;
  font-weight: 700;
  margin-bottom: 32px;
  line-height: 1.6;
}

.start-features {
  display: flex;
  justify-content: center;
  gap: 16px;
  flex-wrap: wrap;
  margin-bottom: 32px;
}

.feature-chip {
  background: linear-gradient(135deg, #FFF0E0, #E8F4FF);
  border-radius: 50px;
  padding: 8px 16px;
  font-size: 0.9rem;
  font-weight: 800;
  color: #555;
  border: 2px solid #EEE;
}

.start-btn {
  display: inline-block;
  padding: 20px 56px;
  font-family: 'Fredoka One', cursive;
  font-size: 1.5rem;
  color: white;
  background: linear-gradient(135deg, var(--mint), var(--blue));
  border: none;
  border-radius: 20px;
  cursor: pointer;
  box-shadow: 0 6px 0 #3388AA;
  transition: all 0.2s cubic-bezier(.34,1.56,.64,1);
  animation: pulseGlow 2s ease-in-out infinite;
}

.start-btn:hover {
  transform: translateY(-4px);
  box-shadow: 0 10px 0 #3388AA;
  animation: none;
}

.start-btn:active {
  transform: translateY(3px);
  box-shadow: 0 3px 0 #3388AA;
}

@keyframes pulseGlow {
  0%,100% { box-shadow: 0 6px 0 #3388AA, 0 0 0 0 rgba(77,150,255,0.3); }
  50%     { box-shadow: 0 6px 0 #3388AA, 0 0 0 12px rgba(77,150,255,0); }
}

.hidden {
  display: none !important;
}