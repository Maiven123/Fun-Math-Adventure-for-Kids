let current = 0;
let score = 0;
let answered = false;

const AudioCtx = window.AudioContext || window.webkitAudioContext;
let ctx;

function getCtx() {
  if (!ctx) ctx = new AudioCtx();
  return ctx;
}

function playCorrectSound() {
  try {
    const c = getCtx();
    const times = [[0, 523], [0.12, 659], [0.24, 784], [0.36, 1047]];
    times.forEach(([t, freq]) => {
      const o = c.createOscillator();
      const g = c.createGain();
      o.connect(g);
      g.connect(c.destination);
      o.type = 'sine';
      o.frequency.value = freq;
      g.gain.setValueAtTime(0.22, c.currentTime + t);
      g.gain.exponentialRampToValueAtTime(0.001, c.currentTime + t + 0.25);
      o.start(c.currentTime + t);
      o.stop(c.currentTime + t + 0.3);
    });
  } catch(e) {}
}

function playWrongSound() {
  try {
    const c = getCtx();
    const o = c.createOscillator();
    const g = c.createGain();
    o.connect(g);
    g.connect(c.destination);
    o.type = 'sawtooth';
    o.frequency.setValueAtTime(300, c.currentTime);
    o.frequency.exponentialRampToValueAtTime(150, c.currentTime + 0.3);
    g.gain.setValueAtTime(0.15, c.currentTime);
    g.gain.exponentialRampToValueAtTime(0.001, c.currentTime + 0.35);
    o.start(c.currentTime);
    o.stop(c.currentTime + 0.4);
  } catch(e) {}
}

function spawnConfetti() {
  const wrap = document.getElementById('confetti');
  wrap.innerHTML = '';
  const colors = ['#FF6B6B','#FFD93D','#6BCB77','#4D96FF','#C77DFF','#FF9A3C'];
  for (let i = 0; i < 40; i++) {
    const p = document.createElement('div');
    p.className = 'confetti-piece';
    p.style.cssText = `
      left: ${Math.random() * 100}vw;
      top: -20px;
      background: ${colors[Math.floor(Math.random() * colors.length)]};
      width: ${6 + Math.random() * 8}px;
      height: ${6 + Math.random() * 8}px;
      border-radius: ${Math.random() > 0.5 ? '50%' : '2px'};
      animation-delay: ${Math.random() * 0.5}s;
      animation-duration: ${0.8 + Math.random() * 0.8}s;
    `;
    wrap.appendChild(p);
  }
  setTimeout(() => wrap.innerHTML = '', 2000);
}

function initStars() {
  const wrap = document.getElementById('stars');
  const icons = ['✨','⭐','🌟','💫','✦'];
  for (let i = 0; i < 15; i++) {
    const s = document.createElement('div');
    s.className = 'star';
    s.textContent = icons[Math.floor(Math.random() * icons.length)];
    s.style.cssText = `
      left: ${Math.random() * 100}vw;
      font-size: ${0.8 + Math.random() * 1.2}rem;
      animation-duration: ${8 + Math.random() * 12}s;
      animation-delay: ${Math.random() * 10}s;
    `;
    wrap.appendChild(s);
  }
}

function startGame() {
  document.getElementById('startScreen').classList.add('hidden');
  document.getElementById('progressWrap').classList.remove('hidden');
  document.getElementById('nextBtn').classList.remove('hidden');
  showQuestion();
}

function showQuestion() {
  answered = false;
  const q = questions[current];

  const pct = Math.round((current / questions.length) * 100);
  document.getElementById('progressFill').style.width = pct + '%';
  document.getElementById('progressLabel').textContent = `Question ${current + 1} of ${questions.length}`;
  document.getElementById('progressPercent').textContent = pct + '%';

  document.getElementById('questionNum').textContent = `Question ${current + 1} of ${questions.length}`;
  document.getElementById('questionText').textContent = q.text;
  document.getElementById('emojiDisplay').innerHTML = q.display;
  document.getElementById('feedback').innerHTML = '';

  const shuffled = [...q.answers].sort(() => Math.random() - 0.5);
  const answersDiv = document.getElementById('answers');
  answersDiv.innerHTML = '';
  shuffled.forEach(ans => {
    const btn = document.createElement('button');
    btn.className = 'answer-btn';
    btn.textContent = ans;
    btn.onclick = () => checkAnswer(btn, ans);
    answersDiv.appendChild(btn);
  });

  const card = document.getElementById('questionCard');
  card.classList.remove('hidden');
  card.style.animation = 'none';
  requestAnimationFrame(() => {
    card.style.animation = 'cardIn 0.5s cubic-bezier(.34,1.56,.64,1) both';
  });

  const nb = document.getElementById('nextBtn');
  nb.disabled = true;
  nb.textContent = current < questions.length - 1 ? 'Next Question →' : 'See My Score! 🏆';
}

function checkAnswer(btn, ans) {
  if (answered) return;
  answered = true;

  const q = questions[current];
  const allBtns = document.querySelectorAll('.answer-btn');
  allBtns.forEach(b => b.disabled = true);

  const fb = document.getElementById('feedback');

  if (ans === q.correct) {
    score++;
    btn.classList.add('correct');
    fb.innerHTML = `<span class="feedback-emoji">🎉</span><span class="feedback-text correct">Awesome! You got it right! 🌟</span>`;
    playCorrectSound();
    spawnConfetti();
    document.getElementById('scoreDisplay').textContent = score;
    const badge = document.getElementById('scoreBadge');
    badge.classList.remove('pop');
    void badge.offsetWidth;
    badge.classList.add('pop');
  } else {
    btn.classList.add('wrong');
    allBtns.forEach(b => {
      if (parseInt(b.textContent) === q.correct) b.classList.add('correct');
    });
    fb.innerHTML = `<span class="feedback-emoji">💪</span><span class="feedback-text wrong">Almost! The answer was ${q.correct}. Keep going!</span>`;
    playWrongSound();
  }

  document.getElementById('nextBtn').disabled = false;
}

function nextQuestion() {
  current++;
  if (current >= questions.length) {
    showResults();
  } else {
    showQuestion();
  }
}

function showResults() {
  document.getElementById('questionCard').classList.add('hidden');
  document.getElementById('nextBtn').classList.add('hidden');
  document.getElementById('progressWrap').classList.add('hidden');

  let trophy, title, message;
  if (score >= 9) {
    trophy = '🏆'; title = 'Amazing!'; message = "You're a Math Superstar! 🌟 Perfect score!";
  } else if (score >= 7) {
    trophy = '🎉'; title = 'Awesome Job!'; message = "You're so smart! Just a few more to go! 😊";
  } else if (score >= 5) {
    trophy = '😊'; title = 'Good Job!'; message = "Great effort! Keep practicing and you'll shine! ✨";
  } else {
    trophy = '💪'; title = 'Keep Trying!'; message = "You can do it! Practice makes perfect! 🌈";
  }

  document.getElementById('resultsTrophy').textContent = trophy;
  document.getElementById('resultsTitle').textContent = title;
  document.getElementById('resultsMessage').textContent = message;
  document.getElementById('finalScore').textContent = `${score}/10`;

  const starsCount = Math.ceil((score / 10) * 5);
  const starsRow = document.getElementById('starsRow');
  starsRow.innerHTML = '';
  for (let i = 0; i < 5; i++) {
    const s = document.createElement('span');
    s.className = 'star-icon';
    s.textContent = i < starsCount ? '⭐' : '☆';
    s.style.animationDelay = (i * 0.1) + 's';
    starsRow.appendChild(s);
  }

  document.getElementById('resultsCard').classList.remove('hidden');

  if (score >= 7) {
    setTimeout(spawnConfetti, 400);
    setTimeout(spawnConfetti, 1200);
  }

  document.getElementById('progressFill').style.width = '100%';
}

function restartGame() {
  current = 0;
  score = 0;
  answered = false;
  document.getElementById('scoreDisplay').textContent = 0;
  document.getElementById('resultsCard').classList.add('hidden');
  document.getElementById('progressWrap').classList.remove('hidden');
  showQuestion();
  document.getElementById('nextBtn').classList.remove('hidden');
}

